# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tokens da API v2 do Tiny (Integrações > API do ERP > Credenciais de acesso,
# campo "Token"), um por empresa. NUNCA cole esses valores em chat/print.
TINY_EMPRESA_A_TOKEN=
TINY_EMPRESA_B_TOKEN=

# CNPJ da Empresa B (só números), usado para reconhecer no pedido de A que o
# cliente é a Empresa B
CNPJ_EMPRESA_B=

# Situação do pedido (texto, minúsculo) que dispara a automação, ex: aprovado
SITUACAO_GATILHO_PEDIDO=aprovado

# Id do depósito de estoque na conta B onde a mercadoria deve entrar
DEPOSITO_ID_EMPRESA_B=

# Segredo que protege a URL do webhook (adicione como ?secret=... na URL
# configurada em Configurações > Webhooks > Receber notificações de vendas,
# na conta A). Gere um valor aleatório qualquer.
WEBHOOK_SECRET=troque-por-um-valor-aleatorio
